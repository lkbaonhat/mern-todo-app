MONGO_URI=mongodb://YOUR_DATABASE_HOST:27017/mern-todo
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Public frontend origin used in password reset links. Use HTTPS outside local development.
FRONTEND_URL=https://todo.example.com
# Mailcow mailbox credentials. Port 587 requires STARTTLS; 465 uses implicit TLS.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=REPLACE_WITH_THE_MAILBOX_PASSWORD
# Use the authenticated mailbox or a sender address explicitly allowed by Mailcow.
MAIL_FROM="MERN Todo <notifications@example.com>"
